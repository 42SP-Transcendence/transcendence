{
  "name": "@transcendence/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Observatório design system.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": {
      "style": "./src/tokens.css",
      "default": "./src/tokens.css"
    }
  },
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --test test/contrast.test.js"
  },
  "devDependencies": {
    "@transcendence/config": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  }
}
